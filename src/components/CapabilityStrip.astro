---
const capabilities = [
  {
    title: '多平台支持',
    desc: '覆盖电脑与移动端常用系统',
    icon: `<svg class="w-5 h-5 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`
  },
  {
    title: '常用地区节点',
    desc: '香港 · 台湾 · 日本 · 新加坡 · 美国',
    icon: `<svg class="w-5 h-5 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    title: '简单订阅',
    desc: '通用订阅链接，主流客户端一键导入',
    icon: `<svg class="w-5 h-5 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>`
  },
  {
    title: '快速连接',
    desc: '优化路由协议，日常连接低延迟',
    icon: `<svg class="w-5 h-5 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: '中文使用体验',
    desc: '界面亲和，清晰明了的使用指引',
    icon: `<svg class="w-5 h-5 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`
  },
];
---

<section class="border-y border-purple-900/30 bg-[#0c0420]/80 py-8 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 lg:gap-4">
      {capabilities.map((item) => (
        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-purple-950/40 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-purple-900/40 border border-purple-600/30 flex items-center justify-center shrink-0 shadow-sm" set:html={item.icon} />
          <div>
            <h3 class="text-sm font-bold text-white tracking-wide">{item.title}</h3>
            <p class="text-xs text-gray-400 mt-1 leading-snug">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
