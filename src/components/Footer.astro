---
import { SITE_CONFIG, FOOTER_SEO_TAGS, NAVIGATION_LINKS } from '../config/site';
---

<footer class="bg-[#060214] border-t border-purple-900/40 text-gray-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 mb-12">
      
      <!-- Brand Column (lg:col-span-5) -->
      <div class="lg:col-span-5 flex flex-col items-start">
        <a href="/" class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-xl bg-purple-900/60 border border-purple-500/40 p-0.5 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 40 40" fill="none">
              <path d="M10 10L30 30M30 10L10 30" stroke="#A855F7" stroke-width="3.5" stroke-linecap="round"/>
              <circle cx="20" cy="20" r="4" fill="#100526" stroke="#7C3AED" stroke-width="2"/>
              <circle cx="20" cy="20" r="2" fill="#FFB800"/>
              <circle cx="10" cy="10" r="2.5" fill="#C084FC"/>
              <circle cx="30" cy="10" r="2.5" fill="#C084FC"/>
              <circle cx="10" cy="30" r="2.5" fill="#C084FC"/>
              <circle cx="30" cy="30" r="2.5" fill="#FFB800"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-bold font-mono text-white tracking-wider">XSUS</span>
            <span class="text-[10px] text-brand-soft/70 tracking-widest leading-none mt-0.5">十八线小机场</span>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-gray-400 leading-relaxed max-w-sm mb-6">
          XSUS 是面向中文用户的网络连接服务品牌，提供常用地区节点及主流客户端订阅支持。致力于以极简稳定的方式提供日常网络加速。
        </p>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-purple-950/60 border border-purple-800/40 text-xs text-brand-soft">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>全网节点与订阅服务正常运行</span>
        </div>
      </div>

      <!-- Quick Nav Links (lg:col-span-3) -->
      <div class="lg:col-span-3">
        <h4 class="text-sm font-bold text-white tracking-wider uppercase mb-4 font-mono">
          快速导航
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {NAVIGATION_LINKS.map((item) => (
            <li>
              <a href={item.href} class="hover:text-brand-soft transition-colors">
                {item.name}
              </a>
            </li>
          ))}
          <li>
            <a href={SITE_CONFIG.registerUrl} target={SITE_CONFIG.target} rel={SITE_CONFIG.rel} class="text-accent hover:underline font-semibold">
              用户注册与登录 →
            </a>
          </li>
        </ul>
      </div>

      <!-- SEO Keywords / Tags (lg:col-span-4) -->
      <div class="lg:col-span-4">
        <h4 class="text-sm font-bold text-white tracking-wider uppercase mb-4 font-mono">
          相关服务与技术
        </h4>
        <div class="flex flex-wrap gap-2">
          {FOOTER_SEO_TAGS.map((tag) => (
            <a
              href="/#"
              class="px-2.5 py-1 text-xs bg-purple-950/40 hover:bg-purple-900/50 text-gray-300 hover:text-white rounded-lg border border-purple-900/30 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-purple-950/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <div>
        <p>© {SITE_CONFIG.year} {SITE_CONFIG.name} · {SITE_CONFIG.subtitle}. All rights reserved.</p>
      </div>

      <!-- Legal Links -->
      <div class="flex items-center gap-6">
        <a href="/privacy/" class="hover:text-gray-300 transition-colors">隐私政策</a>
        <a href="/terms/" class="hover:text-gray-300 transition-colors">服务条款</a>
        <a href="/disclaimer/" class="hover:text-gray-300 transition-colors">免责声明</a>
      </div>
    </div>

  </div>
</footer>
