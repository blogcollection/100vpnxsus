---
import { SITE_CONFIG, NAVIGATION_LINKS } from '../config/site';
---

<header class="sticky top-0 z-40 w-full border-b border-purple-900/40 bg-[#0c041f]/85 backdrop-blur-xl transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-glow rounded-lg">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-brand via-brand-deep to-bg-card p-0.5 shadow-glow-purple group-hover:scale-105 transition-transform duration-200">
          <div class="w-full h-full bg-[#100526] rounded-[10px] flex items-center justify-center relative overflow-hidden">
            <!-- Geometric Tech Icon -->
            <svg class="w-6 h-6" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 10L30 30M30 10L10 30" stroke="#A855F7" stroke-width="3.5" stroke-linecap="round"/>
              <circle cx="20" cy="20" r="4.5" fill="#100526" stroke="#7C3AED" stroke-width="2"/>
              <circle cx="20" cy="20" r="2" fill="#FFB800"/>
              <circle cx="10" cy="10" r="2.5" fill="#C084FC"/>
              <circle cx="30" cy="10" r="2.5" fill="#C084FC"/>
              <circle cx="10" cy="30" r="2.5" fill="#C084FC"/>
              <circle cx="30" cy="30" r="2.5" fill="#FFB800"/>
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-xl sm:text-2xl font-black tracking-wider text-white font-mono leading-none group-hover:text-brand-soft transition-colors">
            XSUS
          </span>
          <span class="text-[11px] font-medium text-brand-soft/70 tracking-widest leading-tight mt-0.5">
            十八线小机场
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {NAVIGATION_LINKS.map((item) => (
          <a
            href={item.href}
            class="px-3.5 py-2 text-sm font-medium text-gray-300 hover:text-white hover:bg-purple-900/30 rounded-lg transition-colors"
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Right Action CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={SITE_CONFIG.registerUrl}
          target={SITE_CONFIG.target}
          rel={SITE_CONFIG.rel}
          class="px-3.5 py-2 text-sm font-medium text-gray-300 hover:text-brand-soft hover:bg-purple-900/20 rounded-lg transition-colors"
        >
          登录 / 使用
        </a>
        <a
          href={SITE_CONFIG.registerUrl}
          target={SITE_CONFIG.target}
          rel={SITE_CONFIG.rel}
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-accent hover:bg-accent-hover text-slate-950 font-bold text-sm rounded-xl transition-all duration-200 shadow-glow-gold hover:shadow-glow-gold hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>立即体验</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={SITE_CONFIG.registerUrl}
          target={SITE_CONFIG.target}
          rel={SITE_CONFIG.rel}
          class="sm:hidden px-3 py-1.5 bg-accent text-slate-950 font-bold text-xs rounded-lg shadow-sm"
        >
          立即体验
        </a>
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="打开导航菜单"
          class="p-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-purple-900/40 focus:outline-none focus:ring-2 focus:ring-brand-glow min-h-[44px] min-w-[44px] flex items-center justify-center"
        >
          <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-purple-900/40 bg-[#0e0422] px-4 pt-3 pb-6 space-y-2">
    {NAVIGATION_LINKS.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link block px-4 py-3 text-base font-medium text-gray-200 hover:text-white hover:bg-purple-900/40 rounded-xl transition-colors"
      >
        {item.name}
      </a>
    ))}
    <div class="pt-4 border-t border-purple-900/40 flex flex-col gap-3">
      <a
        href={SITE_CONFIG.registerUrl}
        target={SITE_CONFIG.target}
        rel={SITE_CONFIG.rel}
        class="w-full flex items-center justify-center py-3 px-4 bg-accent hover:bg-accent-hover text-slate-950 font-bold text-base rounded-xl shadow-glow-gold transition-colors"
      >
        立即体验 XSUS
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
