---
import { SITE_CONFIG } from '../config/site';
---

<section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden bg-network-grid radial-glow-hero">
  <!-- Ambient background glow elements -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute -bottom-20 right-0 w-[450px] h-[450px] bg-brand-deep/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content: 48% (lg:col-span-6 or lg:col-span-5) -->
      <div class="lg:col-span-6 xl:col-span-5 flex flex-col items-start text-left z-10">
        
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-900/50 border border-brand-glow/30 text-xs font-semibold text-brand-soft mb-6 shadow-sm backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>XSUS · 十八线小机场</span>
        </div>

        <!-- H1 (Single H1 on page) -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15] mb-6">
          稳定连接，<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-200 via-brand-soft to-purple-400">
            没有那么复杂。
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed mb-8 max-w-xl">
          XSUS 提供覆盖多个常用地区的网络节点，兼容 Clash、Shadowrocket 等常见客户端，让日常网络连接更简单、更省心。
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-6">
          <a
            href={SITE_CONFIG.registerUrl}
            target={SITE_CONFIG.target}
            rel={SITE_CONFIG.rel}
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-accent hover:bg-accent-hover active:bg-accent-dark text-slate-950 font-extrabold text-base rounded-2xl transition-all duration-200 shadow-glow-gold hover:shadow-glow-gold hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>立即使用 XSUS</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a
            href="#nodes"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-purple-950/60 hover:bg-purple-900/60 text-gray-200 hover:text-white border border-purple-700/40 rounded-2xl font-semibold text-base transition-all duration-200 backdrop-blur-md"
          >
            <span>查看节点分布</span>
            <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>

        <!-- Micro-trust note -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-medium text-gray-400 pt-2 border-t border-purple-900/30 w-full">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>多平台客户端支持</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>常用热门地区节点</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>一键导入简单订阅</span>
          </div>
        </div>

      </div>

      <!-- Right Mockup: 52% (lg:col-span-6 or lg:col-span-7) -->
      <div class="lg:col-span-6 xl:col-span-7 relative flex items-center justify-center lg:justify-end">
        
        <!-- Decorative Ambient Light -->
        <div class="absolute -inset-4 bg-gradient-to-r from-purple-600/20 to-brand-glow/20 rounded-3xl blur-2xl -z-10"></div>

        <!-- Main Desktop Dashboard Mockup (Clean & Crisp Light theme for high SaaS contrast) -->
        <div class="w-full max-w-xl bg-[#0f0728] border border-purple-500/30 rounded-2xl shadow-dashboard p-2 sm:p-3 relative z-10">
          
          <!-- Inner Light Dashboard Surface -->
          <div class="bg-slate-50 text-slate-900 rounded-xl overflow-hidden shadow-inner flex flex-col">
            
            <!-- Window Control Header -->
            <div class="bg-slate-100/90 border-b border-slate-200 px-4 py-2.5 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
                <span class="ml-2 text-xs font-mono font-semibold text-slate-500">XSUS Desktop Client v3.4</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-500">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="font-medium text-emerald-700">Network Ready</span>
              </div>
            </div>

            <!-- Dashboard Main Grid: Sidebar + Center Content -->
            <div class="grid grid-cols-12 min-h-[340px] text-xs sm:text-sm">
              
              <!-- Left Sidebar -->
              <div class="col-span-4 bg-slate-100/70 border-r border-slate-200 p-3 flex flex-col justify-between hidden sm:flex">
                <div class="space-y-1">
                  <!-- Brand Pill -->
                  <div class="flex items-center gap-2 px-2 py-2 mb-3 bg-purple-100 rounded-lg text-purple-900 font-bold">
                    <div class="w-5 h-5 rounded-md bg-purple-700 flex items-center justify-center text-white text-[10px] font-mono">X</div>
                    <span class="font-mono text-xs">XSUS Control</span>
                  </div>

                  <!-- Sidebar Navigation Items -->
                  <div class="px-2.5 py-1.5 rounded-lg bg-purple-600 text-white font-medium flex items-center gap-2 shadow-sm">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                    </svg>
                    <span>控制面板</span>
                  </div>
                  <div class="px-2.5 py-1.5 rounded-lg text-slate-600 hover:bg-slate-200/70 flex items-center gap-2">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>节点列表</span>
                  </div>
                  <div class="px-2.5 py-1.5 rounded-lg text-slate-600 hover:bg-slate-200/70 flex items-center gap-2">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span>订阅管理</span>
                  </div>
                  <div class="px-2.5 py-1.5 rounded-lg text-slate-600 hover:bg-slate-200/70 flex items-center gap-2">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span>流量统计</span>
                  </div>
                </div>

                <div class="pt-2 border-t border-slate-200">
                  <div class="flex items-center gap-2 px-2 py-1 text-slate-500 text-xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>账号正常</span>
                  </div>
                </div>
              </div>

              <!-- Main Center Connection Card -->
              <div class="col-span-12 sm:col-span-8 p-4 bg-white flex flex-col justify-between">
                
                <!-- Status Row -->
                <div>
                  <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <div>
                      <span class="text-[11px] font-semibold text-slate-400 tracking-wide uppercase">Current Node</span>
                      <h4 class="text-sm sm:text-base font-bold text-slate-800 flex items-center gap-1.5">
                        <span class="text-base">🇭🇰</span>
                        <span>香港专线节点 - HK 01</span>
                      </h4>
                    </div>
                    <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-[11px] font-bold rounded-full border border-emerald-300/60 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                      CONNECTED
                    </span>
                  </div>

                  <!-- Quick Stats Grid -->
                  <div class="grid grid-cols-3 gap-2 my-3">
                    <div class="bg-slate-50 p-2 rounded-lg border border-slate-100">
                      <span class="text-[10px] text-slate-400 block">延迟 Latency</span>
                      <span class="font-mono font-bold text-xs sm:text-sm text-purple-700">42 ms</span>
                    </div>
                    <div class="bg-slate-50 p-2 rounded-lg border border-slate-100">
                      <span class="text-[10px] text-slate-400 block">协议 Protocol</span>
                      <span class="font-mono font-bold text-xs sm:text-sm text-slate-700">AUTO</span>
                    </div>
                    <div class="bg-slate-50 p-2 rounded-lg border border-slate-100">
                      <span class="text-[10px] text-slate-400 block">状态 Network</span>
                      <span class="font-bold text-xs sm:text-sm text-emerald-600">Protected</span>
                    </div>
                  </div>

                  <!-- Quick Node Mini List -->
                  <div class="space-y-1.5 mt-2">
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">常用地区节点</span>
                    
                    <div class="flex items-center justify-between px-2.5 py-1.5 rounded bg-purple-50 border border-purple-100 text-xs">
                      <div class="flex items-center gap-2">
                        <span>🇭🇰</span>
                        <span class="font-medium text-purple-900">香港 (Hong Kong)</span>
                      </div>
                      <span class="text-[11px] font-mono font-medium text-emerald-600">Online · 42ms</span>
                    </div>

                    <div class="flex items-center justify-between px-2.5 py-1.5 rounded bg-slate-50 hover:bg-slate-100 text-xs">
                      <div class="flex items-center gap-2">
                        <span>🇹🇼</span>
                        <span class="font-medium text-slate-700">台湾 (Taiwan)</span>
                      </div>
                      <span class="text-[11px] font-mono font-medium text-emerald-600">Online · 56ms</span>
                    </div>

                    <div class="flex items-center justify-between px-2.5 py-1.5 rounded bg-slate-50 hover:bg-slate-100 text-xs">
                      <div class="flex items-center gap-2">
                        <span>🇯🇵</span>
                        <span class="font-medium text-slate-700">日本 (Tokyo)</span>
                      </div>
                      <span class="text-[11px] font-mono font-medium text-emerald-600">Online · 68ms</span>
                    </div>

                    <div class="flex items-center justify-between px-2.5 py-1.5 rounded bg-slate-50 hover:bg-slate-100 text-xs">
                      <div class="flex items-center gap-2">
                        <span>🇸🇬</span>
                        <span class="font-medium text-slate-700">新加坡 (Singapore)</span>
                      </div>
                      <span class="text-[11px] font-mono font-medium text-emerald-600">Online · 72ms</span>
                    </div>

                    <div class="flex items-center justify-between px-2.5 py-1.5 rounded bg-slate-50 hover:bg-slate-100 text-xs">
                      <div class="flex items-center gap-2">
                        <span>🇺🇸</span>
                        <span class="font-medium text-slate-700">美国 (United States)</span>
                      </div>
                      <span class="text-[11px] font-mono font-medium text-emerald-600">Online · 145ms</span>
                    </div>
                  </div>
                </div>

              </div>

            </div>

          </div>

        </div>

        <!-- Overlaid Mobile App Mockup (Positioned bottom right) -->
        <div class="hidden sm:block absolute -bottom-6 -right-3 w-48 bg-slate-900 border-2 border-purple-400/50 rounded-3xl p-2 shadow-2xl z-20 transform rotate-1 hover:rotate-0 transition-transform duration-300">
          <div class="bg-[#13072b] rounded-2xl p-3 text-white flex flex-col items-center text-center">
            
            <!-- Mobile Notch -->
            <div class="w-16 h-3 bg-slate-800 rounded-full mb-3"></div>
            
            <span class="text-[10px] font-bold text-brand-soft uppercase tracking-wider">XSUS Mobile</span>
            <span class="text-xs font-bold text-white mt-1">Tokyo / Japan</span>
            <span class="text-[10px] text-emerald-400 font-mono mt-0.5">CONNECTED</span>

            <!-- Center Circular Connect Button -->
            <div class="my-3 w-14 h-14 rounded-full bg-gradient-to-tr from-brand-deep to-brand-glow p-1 shadow-glow-purple flex items-center justify-center cursor-pointer">
              <div class="w-full h-full bg-[#18073a] rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
            </div>

            <div class="w-full bg-purple-950/80 rounded-lg py-1 px-2 flex justify-between text-[9px] text-gray-300">
              <span>Ping: 68ms</span>
              <span>TLS 1.3</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
