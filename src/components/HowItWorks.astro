---
import { SITE_CONFIG } from '../config/site';

const steps = [
  {
    step: '01',
    title: '注册 XSUS 账号',
    desc: '进入 XSUS 注册页面，完成快捷注册并选择适合你日常用量的订阅方案。',
    tag: '只需 1 分钟',
    icon: `<svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>`
  },
  {
    step: '02',
    title: '获取专属订阅链接',
    desc: '在后台控制面板中，一键复制对应 Clash、Shadowrocket 或通用协议的订阅地址。',
    tag: '一键自动同步',
    icon: `<svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>`
  },
  {
    step: '03',
    title: '导入客户端并开启连接',
    desc: '将订阅粘贴至客户端完成节点下载，选择常用地区节点（如香港、日本等）开启代理。',
    tag: '即刻畅联网络',
    icon: `<svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
];
---

<section id="how-it-works" class="py-20 lg:py-28 bg-[#080318] relative bg-network-grid">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/40 border border-purple-500/30 text-xs font-semibold text-brand-soft mb-4">
        <span>GETTING STARTED</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight mb-4">
        三步即可完成配置并开始使用
      </h2>
      <p class="text-base sm:text-lg text-gray-300">
        没有复杂的参数调试，清晰简短的三步流程，即刻享受稳定网络体验。
      </p>
    </div>

    <!-- Steps Container with Connected Flow Line -->
    <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      
      <!-- Desktop Connecting Horizontal Line -->
      <div class="hidden md:block absolute top-1/2 left-1/6 right-1/6 h-0.5 bg-gradient-to-r from-purple-700 via-brand-glow to-accent -translate-y-12 z-0 opacity-40"></div>

      {steps.map((item) => (
        <div class="relative z-10 glass-card rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center hover:border-purple-400/50 transition-all duration-300 group">
          
          <!-- Step Number Badge / Icon -->
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-brand-deep via-brand to-purple-600 p-0.5 mb-6 shadow-glow-purple group-hover:scale-105 transition-transform">
            <div class="w-full h-full bg-[#12052c] rounded-[14px] flex items-center justify-center">
              <span class="font-mono text-xl font-black text-brand-soft">
                {item.step}
              </span>
            </div>
          </div>

          <span class="text-xs font-semibold text-accent mb-2">{item.tag}</span>
          <h3 class="text-lg sm:text-xl font-bold text-white mb-3 group-hover:text-brand-soft transition-colors">
            {item.title}
          </h3>
          <p class="text-sm text-gray-300 leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- CTA Section Action -->
    <div class="text-center">
      <a
        href={SITE_CONFIG.registerUrl}
        target={SITE_CONFIG.target}
        rel={SITE_CONFIG.rel}
        class="inline-flex items-center gap-2.5 px-8 py-4 bg-accent hover:bg-accent-hover text-slate-950 font-extrabold text-base rounded-2xl transition-all shadow-glow-gold hover:-translate-y-0.5"
      >
        <span>开始使用 XSUS</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
