---
import { SITE_CONFIG } from '../config/site';

const planFeatures = [
  '包含香港、台湾、日本、新加坡、美国等常用地区节点',
  '支持 Clash Verge、Shadowrocket、Clash Meta 等主流客户端',
  '全平台支持：Windows、macOS、iOS、Android、Linux',
  '一键复制通用订阅链接，智能分流与规则切换',
  'BGP 优质接入与多机房负载均衡保护',
  '详细图文新手入门教程与客户服务支持',
];
---

<section id="pricing" class="py-20 lg:py-28 bg-[#080318] relative bg-network-grid">
  <!-- Center Ambient Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-brand/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/40 border border-purple-500/30 text-xs font-semibold text-brand-soft mb-4">
        <span>FLEXIBLE PLANS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight mb-4">
        选择适合你的 XSUS 套餐
      </h2>
      <p class="text-base sm:text-lg text-gray-300">
        提供不同周期与流量规格方案，满足轻度查询到高频办公的多元需求。
      </p>
    </div>

    <!-- Featured Pricing Box (High Contrast SaaS Card) -->
    <div class="glass-card-elevated rounded-3xl p-8 sm:p-12 border-2 border-purple-500/40 shadow-2xl relative overflow-hidden text-center sm:text-left">
      
      <!-- Top Right Badge -->
      <div class="sm:absolute sm:top-8 sm:right-8 mb-6 sm:mb-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-accent/20 border border-accent/40 rounded-full text-accent font-bold text-xs">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span>实时套餐与周期可选</span>
      </div>

      <div class="max-w-xl">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand-soft">XSUS Standard Access</span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-1 mb-4">
          全功能标准订阅计划
        </h3>
        <p class="text-sm text-gray-300 leading-relaxed mb-8">
          无需纠结复杂配置，所有套餐均标配常用地区节点与高速接入通道，按需选择适合你的使用周期与流量包即可。
        </p>
      </div>

      <!-- Feature Checklist -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-10 text-left">
        {planFeatures.map((feat) => (
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full bg-purple-900/60 border border-purple-400/40 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="text-xs sm:text-sm text-gray-200">{feat}</span>
          </div>
        ))}
      </div>

      <!-- Main Action -->
      <div class="pt-6 border-t border-purple-800/40 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-center sm:text-left">
          <p class="text-xs text-gray-400">
            * 套餐、节点、流量及价格以注册页面实时显示为准
          </p>
        </div>

        <a
          href={SITE_CONFIG.registerUrl}
          target={SITE_CONFIG.target}
          rel={SITE_CONFIG.rel}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-accent hover:bg-accent-hover active:bg-accent-dark text-slate-950 font-extrabold text-base rounded-2xl transition-all shadow-glow-gold hover:-translate-y-0.5 shrink-0"
        >
          <span>查看最新套餐 →</span>
        </a>
      </div>

    </div>

  </div>
</section>
