---
const cards = [
  {
    num: '01',
    title: '常用地区节点',
    summary: '覆盖高频使用的亚太及北美核心节点',
    details: '精选香港、台湾、日本、新加坡、美国等主流地区节点，满足日常网页浏览、资料检索及海外多区域业务访问需求。',
    tags: ['香港', '台湾', '日本', '新加坡', '美国'],
    icon: `<svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    num: '02',
    title: '主流客户端兼容',
    summary: '支持 Windows、Mac、iOS 及 Android 各类软件',
    details: '全面适配 Clash Verge、Clash Meta、Shadowrocket、V2Ray、Trojan 等常见代理客户端与协议标准。',
    tags: ['Clash Verge', 'Shadowrocket', 'Clash Meta', 'V2Ray', 'Trojan'],
    icon: `<svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`
  },
  {
    num: '03',
    title: '简单清晰的配置流程',
    summary: '告别繁琐设置，一键复制订阅即可使用',
    details: '提供标准化通用订阅链接与清晰的使用指引，无论是新手还是资深用户都能在几分钟内完成导入与连接。',
    tags: ['一键订阅', '多协议适配', '新手友好', '快速同步'],
    icon: `<svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`
  },
  {
    num: '04',
    title: '适合日常网络需求',
    summary: '面向真实工作、学习与信息获取场景',
    details: '满足日常海外网页浏览、学术文献查找、跨境远程办公、海外社交沟通与 AI 工具辅助等多元网络连接需求。',
    tags: ['网页浏览', '海外办公', '学术研究', 'AI 辅助', '资讯同步'],
    icon: `<svg class="w-6 h-6 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>`
  }
];
---

<section id="why" class="py-20 lg:py-28 bg-[#0c0420] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight mb-4">
        为什么选择 XSUS？
      </h2>
      <p class="text-base sm:text-lg text-gray-300">
        不是把功能写得越复杂越好。我们更关注日常实际使用体验。
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {cards.map((card) => (
        <div class="glass-card rounded-2xl p-6 sm:p-8 hover:-translate-y-1 transition-all duration-300 relative group overflow-hidden">
          <!-- Subtle Top Border Accent on hover -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand via-brand-glow to-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-purple-900/50 border border-purple-500/30 flex items-center justify-center shadow-sm" set:html={card.icon} />
            <span class="font-mono text-2xl sm:text-3xl font-black text-purple-700/60 group-hover:text-purple-400/80 transition-colors">
              {card.num}
            </span>
          </div>

          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-brand-soft transition-colors">
            {card.title}
          </h3>
          <p class="text-sm font-semibold text-brand-soft/90 mb-3">
            {card.summary}
          </p>
          <p class="text-sm text-gray-300 leading-relaxed mb-6">
            {card.details}
          </p>

          <!-- Badges / Tags -->
          <div class="flex flex-wrap gap-2 pt-4 border-t border-purple-900/30">
            {card.tags.map((tag) => (
              <span class="px-2.5 py-1 text-xs font-medium bg-purple-950/70 text-purple-200 border border-purple-800/40 rounded-lg">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Disclaimer Note -->
    <div class="mt-8 text-center">
      <p class="text-xs text-gray-400">
        * 提示：实际网络可用情况受本地宽带类型、国际路由波动及目标平台访问策略影响，XSUS 持续进行线路维护与优化。
      </p>
    </div>

  </div>
</section>
