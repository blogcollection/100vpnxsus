---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="页面未找到 - XSUS 十八线小机场"
  description="页面未找到 - XSUS 404"
  canonicalUrl="https://vpnxsus.homes/404.html"
>
  <Header />

  <main class="py-24 sm:py-32 bg-[#080318] relative bg-network-grid flex-1 flex items-center justify-center">
    <div class="max-w-md mx-auto px-4 text-center">
      <div class="w-20 h-20 mx-auto rounded-3xl bg-purple-900/50 border border-purple-500/40 flex items-center justify-center mb-6 text-brand-glow">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>

      <span class="font-mono text-4xl sm:text-5xl font-black text-white block mb-2">404</span>
      <h1 class="text-xl sm:text-2xl font-bold text-white mb-4">抱歉，页面不存在或已迁移</h1>
      <p class="text-sm text-gray-400 mb-8 leading-relaxed">
        您访问的页面链接可能已失效。请点击下方按钮返回 XSUS 首页。
      </p>

      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-accent hover:bg-accent-hover text-slate-950 font-bold text-sm rounded-xl transition-all shadow-glow-gold"
      >
        <span>返回 XSUS 首页</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
