---
import Layout from '../../layouts/Layout.astro';
import PromotionalBar from '../../components/PromotionalBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="隐私政策 - XSUS 十八线小机场"
  description="XSUS 隐私政策：了解我们如何收集、使用和保护您的个人数据与网络连接隐私。"
  canonicalUrl="https://vpnxsus.homes/privacy/"
>
  <PromotionalBar />
  <Header />

  <main class="py-16 sm:py-24 bg-[#080318] relative bg-network-grid">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="glass-card rounded-3xl p-8 sm:p-12 border border-purple-800/40">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-6">
          隐私政策 (Privacy Policy)
        </h1>
        <p class="text-xs sm:text-sm text-brand-soft/70 mb-8 font-mono">
          最后更新时间：2026 年 10 月
        </p>

        <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
          <section>
            <h2 class="text-lg font-bold text-white mb-2">1. 信息收集范围</h2>
            <p>
              XSUS 仅在您自愿注册账户和订购服务时收集必要的账户凭证（如电子邮箱）。我们严格遵循数据最小化原则，不主动索取非必要的敏感个人身份信息。
            </p>
          </section>

          <section>
            <h2 class="text-lg font-bold text-white mb-2">2. 网络日志与浏览记录</h2>
            <p>
              我们坚决维护用户网络通信的私密性。XSUS 节点服务器不记录、不存储用户访问的目标具体网址、网页浏览历史或通信传输的具体内容。系统仅在内存中保留用于统计套餐已用流量的聚合计数器。
            </p>
          </section>

          <section>
            <h2 class="text-lg font-bold text-white mb-2">3. 数据安全与传输加密</h2>
            <p>
              所有用户中心数据均采用业界标准的加密算法（如 TLS 1.3）在传输过程中进行端到端保护。我们实施了严格的机房安全访问控制策略，防止未经授权的数据泄露或篡改。
            </p>
          </section>

          <section>
            <h2 class="text-lg font-bold text-white mb-2">4. 第三方服务与外链</h2>
            <p>
              本网站可能包含指向第三方支付或服务平台的外部链接。当您离开 XSUS 站点时，请参阅对应第三方平台的独立隐私声明。
            </p>
          </section>

          <section>
            <h2 class="text-lg font-bold text-white mb-2">5. 政策更新与咨询</h2>
            <p>
              XSUS 保留根据技术架构演进和法律合规要求适时修订本隐私政策的权利。若您对个人数据安全有任何疑问，请通过用户支持中心发起咨询。
            </p>
          </section>
        </div>

        <div class="mt-10 pt-6 border-t border-purple-900/30 flex justify-between items-center">
          <a href="/" class="text-sm font-semibold text-brand-soft hover:text-white transition-colors">
            ← 返回 XSUS 首页
          </a>
          <a href="https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso" target="_blank" rel="nofollow sponsored noopener noreferrer" class="text-sm font-bold text-accent hover:underline">
            进入用户中心 →
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
